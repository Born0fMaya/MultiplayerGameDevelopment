<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GameWindow</AssemblyName>
    <RootNamespace>GameWindow</RootNamespace>
    <Version>1.1.7</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="DefaultShell\**\*" LogicalName="DefaultShell/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Bundled collab helper: lives next to the app, not a separate user install. -->
  <PropertyGroup>
    <CloudflaredVersion>2026.11.1</CloudflaredVersion>
    <CloudflaredDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\Tools'))</CloudflaredDir>
    <CloudflaredExe>$(CloudflaredDir)\cloudflared.exe</CloudflaredExe>
    <CloudflaredUrl>https://github.com/cloudflare/cloudflared/releases/download/$(CloudflaredVersion)/cloudflared-windows-amd64.exe</CloudflaredUrl>
  </PropertyGroup>

  <Target Name="EnsureCloudflared" BeforeTargets="Build;Publish">
    <MakeDir Directories="$(CloudflaredDir)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;if (-not (Test-Path -LiteralPath '$(CloudflaredExe)')) { Write-Host 'Downloading bundled cloudflared…'; Invoke-WebRequest -Uri '$(CloudflaredUrl)' -OutFile '$(CloudflaredExe)' -UseBasicParsing }&quot;"
          Condition="!Exists('$(CloudflaredExe)')"
          IgnoreExitCode="false" />
    <Warning Text="Bundled cloudflared.exe is missing at $(CloudflaredExe). Online share-link collab will try to download it at runtime."
             Condition="!Exists('$(CloudflaredExe)')" />
  </Target>

  <ItemGroup Condition="Exists('$(CloudflaredExe)')">
    <Content Include="$(CloudflaredExe)" Link="Tools\cloudflared.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

</Project>
