    {
      "id": "part-26",
      "name": "PlayerMovement 3",
      "shape": "script",
      "width": 1,
      "height": 1,
      "depth": 1,
      "position": [
        10,
        2,
        22
      ],
      "rotation": [
        0,
        0,
        0
      ],
      "color": "#fcfcfc",
      "script": {
        "enabled": true,
        "source": "local RunService = game:GetService(\"RunService\")\nlocal UIS = game:GetService(\"UserInputService\")\nlocal character = game.Players.LocalPlayer.Character\n\nif not character then return end\ncharacter.Anchored = false\n\nlocal grounded = true\n\nRunService.Heartbeat:Connect(function(dt)\n    local camera = workspace.CurrentCamera\n    local lookVector = camera.CFrame.LookVector\n    local forward = Vector3.new(lookVector.X, 0, lookVector.Z)\n    local right = Vector3.new(-lookVector.Z, 0, lookVector.X)\n\n    local moveDir = Vector3.new(0,0,0)\n    if UIS:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + forward end\n    if UIS:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - forward end\n    if UIS:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - right end\n    if UIS:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + right end\n\n    if moveDir:Magnitude() > 0 then\n        moveDir = moveDir:Unit()\n        character.AssemblyLinearVelocity = Vector3.new(moveDir.X * 5, character.AssemblyLinearVelocity.Y, moveDir.Z * 5)\n    end\n\n    grounded = character:IsGrounded()\nend)\n\nUIS.InputBegan:Connect(function(input)\n    if input.KeyCode.Name == \"Space\" and grounded then\n        character:ApplyImpulse(Vector3.new(0, 20, 0))\n        grounded = false\n    end\nend)"
      }
    },
